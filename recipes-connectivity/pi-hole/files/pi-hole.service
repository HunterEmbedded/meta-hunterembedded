[Unit]
Description=Start Pi-Hole service

Wants=pihole-FTL.service time-sync.target systemd-time-wait-sync.service
After=pihole-FTL.service time-sync.target systemd-time-wait-sync.service


[Service]
Type=oneshot
WorkingDirectory=/home/admin
ExecStart=/opt/pihole/start-pihole.sh

[Install]
WantedBy=multi-user.target 