# fstab for pi-hole image
/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

# extra partitions mounted for RAUC
# /u-boot contains uboot.env that RAUC needs to access and must be FAT for uboot to access
/dev/mmcblk0p1	/u-boot	vfat	defaults	0	0
# /data contains the RAUC status information and persistent /etc files
/dev/mmcblk0p4	/data	ext4	defaults	0	0
